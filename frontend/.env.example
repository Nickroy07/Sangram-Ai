# ==============================================================================
# SANGRAM AI FRONTEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In development:
#   VITE_API_BASE_URL=http://localhost:8000
#
# In production (Hostinger deployment):
#   Set VITE_API_BASE_URL to your deployed FastAPI backend URL, e.g.:
#   VITE_API_BASE_URL=https://api.sangramai.tech
#
# Google Sign-In:
#   Create an OAuth 2.0 Client ID in Google Cloud Console (Web application).
#   Add https://sangramai.tech and http://localhost:3000 to Authorized JavaScript origins.
#   VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
#
# IMPORTANT:
#   Variables prefixed with VITE_ are embedded into the client bundle at build time.
#   NEVER place database passwords, JWT secret keys, or AI provider keys here.
# ==============================================================================

VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
