# ==============================================================================
# SANGRAM AI BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env (or 'Copy-Item .env.example .env' in PowerShell)
#
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Runtime Environment (development | test | production)
ENVIRONMENT=development

# Debug Mode (MUST BE false in production; true enables verbose logging)
DEBUG=false

# Project Identity
PROJECT_NAME="Sangram AI Backend"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Server Network Binding
HOST=0.0.0.0
PORT=8000

# Security: Secret Key used for session signing and token encryption.
# In production, this MUST be a high-entropy string (min 32 chars) not containing 'dev' or 'insecure'.
SECRET_KEY=dev-insecure-secret-key-change-in-production-min32chars!

# CORS Allowed Origins (Comma-separated list or JSON array)
# In production, wildcards (*) are forbidden and will fail startup validation.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (PostgreSQL with asyncpg driver)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sangram_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=3.0
DB_HEALTH_TIMEOUT_SECONDS=2.0

# Structured Logging
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------------------------
# Optional credentials. Provider and payment secrets must remain server-side.
# ------------------------------------------------------------------------------
# Developer 2: Authentication & Sessions
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Auth cookies: COOKIE_SECURE MUST be true in production (HTTPS only)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:3000
# Google OAuth Client ID (must match frontend VITE_GOOGLE_CLIENT_ID for ID token audience validation)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email: "console" prints codes/links to the server log (dev only); "smtp" for real delivery
EMAIL_BACKEND=console
EMAIL_FROM="Sangram AI <no-reply@sangram.ai>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# Developer 3: AI Model Gateway
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# MISTRAL_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=

# Developer 5: Payments & Entitlements
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
